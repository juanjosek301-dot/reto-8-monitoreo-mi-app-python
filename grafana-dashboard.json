{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "annotations": {"list": []},
  "description": "Operación y pedidos de Café Nube API.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"expr": "sum(rate(mi_app_http_requests_total{job=\"mi-app-python\"}[1m])) by (path)", "legendFormat": "{{path}}", "refId": "A"}],
      "title": "Tráfico HTTP por ruta",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(mi_app_orders_created_total{job=\"mi-app-python\"})", "legendFormat": "Pedidos", "refId": "A"}],
      "title": "Pedidos creados",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"expr": "mi_app_orders_current{job=\"mi-app-python\"}", "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Pedidos activos por estado",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "currencyCOP"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(rate(mi_app_order_value_cop_sum{job=\"mi-app-python\"}[5m])) / sum(rate(mi_app_order_value_cop_count{job=\"mi-app-python\"}[5m]))", "legendFormat": "Promedio COP", "refId": "A"}],
      "title": "Valor promedio del pedido (COP)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"expr": "sum(increase(mi_app_business_errors_total{job=\"mi-app-python\"}[5m])) by (error_type)", "legendFormat": "{{error_type}}", "refId": "A"}],
      "title": "Errores de negocio en los últimos 5 minutos",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["reto8", "mi-app-python", "cafe-nube"],
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Café Nube API",
  "uid": "cafe-nube-api",
  "version": 2
